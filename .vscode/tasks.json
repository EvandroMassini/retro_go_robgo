{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "RobGo: verificar ESP-IDF",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "tools/build_robgo.py",
        "check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "RobGo: compilar imagem completa",
      "type": "process",
      "command": "${command:python.interpreterPath}",
      "args": [
        "tools/build_robgo.py",
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    }
  ]
}
